# Uniswap web gateway API key (defaults to public app.uniswap.org key if unset)
UNISWAP_API_KEY=JoyCGj29tT4pymvhaGciK4r1aIPvqW6W53xT1fwo
# Optional: same value exposed to client bundle (only needed if calling web-quotes from client)
NEXT_PUBLIC_UNISWAP_API_KEY=JoyCGj29tT4pymvhaGciK4r1aIPvqW6W53xT1fwo

# Optional: max concurrent web-quote requests during full chain scan (default 8)
SCAN_CONCURRENCY=8

# Optional: per-chain RPC overrides (defaults to publicnode.com)
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# BASE_RPC_URL=https://base-rpc.publicnode.com
# OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com

# Optional: Neon Postgres for price-history DB (kimchi comparison charts).
# Unset = history chart hidden, everything else works. Get one at https://neon.tech
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
# Shared secret for /api/collect (also set as GitHub Actions secret CRON_KEY)
# CRON_SECRET=

# Optional: LLM refinement for Square signal extraction (OpenAI-compatible chat completions).
# Unset = rule-based extraction only. Set all three to enable AI upgrades with violet "AI" badge.
# SQUARE_LLM_BASE=https://api.openai.com/v1
# SQUARE_LLM_KEY=
# SQUARE_LLM_MODEL=gpt-4o-mini
